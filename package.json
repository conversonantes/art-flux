{
  "name": "art-flux",
  "private": true,
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @art-flux/api dev",
    "dev:web": "pnpm --filter @art-flux/web dev",
    "check:conexion": "node scripts/check-connection.mjs",
    "migrar": "node scripts/migrate.mjs",
    "test:int": "pnpm --filter @art-flux/adapters test:int && pnpm --filter @art-flux/api test:int"
  },
  "devDependencies": {
    "@types/node": "22",
    "pg": "^8.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
